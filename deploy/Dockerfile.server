# Central server image (v1). VictoriaMetrics runs as a child process (server.vm.mode: child).
# cross-compiles on the build host, so multi-arch images need no emulation
FROM --platform=$BUILDPLATFORM golang:1.27 AS build
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOARCH=$TARGETARCH go build -trimpath -buildvcs=false \
    -ldflags "-s -w -X main.version=$VERSION" -o /out/kurogane ./cmd/kurogane

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/kurogane /usr/bin/kurogane
ENV KRGN_SERVER_VM_MODE=child KRGN_DATA_DIR=/var/lib/kurogane KRGN_PRIVSEP=false
VOLUME ["/var/lib/kurogane", "/etc/kurogane"]
EXPOSE 9443 9444
ENTRYPOINT ["/usr/bin/kurogane", "server", "run", "--config", "/etc/kurogane/config.yaml"]
