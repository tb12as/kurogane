[Unit]
Description=ServerKeeper central server
After=network-online.target serverkeeper-vm.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/serverkeeper server run --config /etc/serverkeeper/config.yaml
Restart=always
RestartSec=5
User=serverkeeper
Group=serverkeeper
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/serverkeeper
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
